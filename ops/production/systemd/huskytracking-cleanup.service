[Unit]
Description=Remove expired Husky Tracking demo workspaces
Wants=docker.service
After=docker.service
ConditionPathExists=/etc/huskytracking/.env.production
ConditionPathIsDirectory=/opt/huskytracking

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
WorkingDirectory=/opt/huskytracking
ExecStart=/opt/huskytracking/ops/production/cleanup.sh
TimeoutStartSec=30m
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
StandardOutput=journal
StandardError=journal
SyslogIdentifier=huskytracking-cleanup
