# Public, non-secret deployment identity
APP_ENV=production
PUBLIC_BASE_URL=https://huskytracking.com
ALLOWED_HOSTS=huskytracking.com,www.huskytracking.com
CORS_ORIGINS=https://huskytracking.com
LOG_LEVEL=INFO
UVICORN_WORKERS=1
# Review against the actual dedicated Docker ingress subnet before public launch.
TRUSTED_PROXY_CIDR=172.30.50.0/24

# Generate private database credentials; never commit the completed file.
POSTGRES_DB=husky_tracking
POSTGRES_USER=husky_tracking_app
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD
DATABASE_URL=postgresql+psycopg://husky_tracking_app:REPLACE_WITH_URL_ENCODED_PASSWORD@db:5432/husky_tracking
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# Fixed synthetic demo clock and anonymous workspace settings
DEMO_SEASON_START=2025-12-01
DEMO_SEASON_END=2026-03-31
DEMO_REFERENCE_DATE=2026-03-31
DEMO_RESET_ENABLED=false
DEMO_WORKSPACE_TTL_HOURS=24
DEMO_SESSION_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
DEMO_COOKIE_SECURE=true
DEMO_ORIGIN_CHECK_ENABLED=true

# Confirmed public controller facts. The private forwarding destination is not recorded.
PRIVACY_CONTROLLER_NAME=Oleg Shaltaev
PRIVACY_CONTACT_EMAIL=privacy@huskytracking.com
PRIVACY_CONTROLLER_COUNTRY=Finland
PRIVACY_HOSTING_REGION=Netherlands (EEA)
PRIVACY_EFFECTIVE_DATE=2026-09-18
PRIVACY_MAIL_PROVIDER_NAME=
PRIVACY_MAIL_PROVIDER_REGION=

# Use disabled until SMTP is deliberately configured. SMTP mode requires encryption.
CONTACT_DELIVERY_MODE=disabled
CONTACT_RECIPIENT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
