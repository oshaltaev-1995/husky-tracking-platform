# Development template. Copy to .env for local Compose only. Never commit .env.

# Application
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:4300
LOG_LEVEL=INFO
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CORS_ORIGINS=http://localhost:4300,http://localhost:8080

# Database
POSTGRES_DB=husky_tracking
POSTGRES_USER=husky_tracking
POSTGRES_PASSWORD=husky_tracking_dev
POSTGRES_PORT=5433
BACKEND_PORT=8030
FRONTEND_PORT=4300
DATABASE_URL=postgresql+psycopg://husky_tracking:husky_tracking_dev@db:5432/husky_tracking
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# Canonical demo clock
DEMO_SEASON_START=2025-12-01
DEMO_SEASON_END=2026-03-31
DEMO_REFERENCE_DATE=2026-03-31
# Local-only guard for the app-owned demo reset CLI. Never enable in production.
DEMO_RESET_ENABLED=true
DEMO_WORKSPACE_TTL_HOURS=24
DEMO_SESSION_SECRET=development-only-demo-session-secret
DEMO_COOKIE_SECURE=false
DEMO_ORIGIN_CHECK_ENABLED=false

# Public privacy/controller metadata. Replace all placeholders before production.
PRIVACY_CONTROLLER_NAME=Husky Tracking project operator
PRIVACY_CONTACT_EMAIL=privacy@example.invalid
PRIVACY_CONTROLLER_COUNTRY=Not configured
PRIVACY_HOSTING_REGION=Not configured
PRIVACY_EFFECTIVE_DATE=2026-09-18
PRIVACY_MAIL_PROVIDER_NAME=
PRIVACY_MAIL_PROVIDER_REGION=

# Public contact form. Local `sink` mode logs only message metadata and sends nothing.
# Use `disabled` to return a safe unavailable response, or `smtp` with all required values.
CONTACT_DELIVERY_MODE=sink
CONTACT_RECIPIENT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10

# Deployment (production Compose only)
PUBLIC_HTTP_PORT=8080
UVICORN_WORKERS=2
